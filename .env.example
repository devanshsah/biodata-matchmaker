# Copy to .env and fill in.

# Required: database password (any long random string).
DB_PASSWORD=change-me-long-random-string

# Optional: host port for the site (default 8080).
PORT=8080

# Optional: fixed key for signing sign-in cookies. Leave empty to auto-generate one (stored in the database).
SESSION_SECRET=

# Recommended: your email, used to identify the server to Apple/Google push services.
VAPID_SUBJECT=mailto:you@example.com

# Optional: lets "Read numbers from the photo" fill in body-scan values. Key from https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: only for the Cloudflare Tunnel service.
CLOUDFLARE_TUNNEL_TOKEN=
